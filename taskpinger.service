[Unit]
Description=TaskPinger 88n77 Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ЗМІНИ User і шляхи під свій сервер:
User=root
WorkingDirectory=/opt/taskpinger
Environment=TZ=Europe/Kyiv
ExecStart=/opt/taskpinger/.venv/bin/python /opt/taskpinger/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
